# Salin file ini menjadi ".env" lalu isi untuk auto-login LIVE saat server start.
# Tanpa file ini, login live tetap bisa lewat form "Login Broker" di website.

# Token MetaApi — buat gratis di https://app.metaapi.cloud (menu API tokens)
# Jika akun Exness kamu SUDAH terdaftar di dashboard MetaApi, token ini saja
# cukup: server otomatis mencari akun tersebut dan langsung login LIVE.
METAAPI_TOKEN=

# Opsional: paksa pakai akun MetaApi tertentu (id dari dashboard MetaApi),
# berguna jika ada lebih dari satu akun terdaftar.
# METAAPI_ACCOUNT_ID=

# Kredensial akun MT5 Exness — hanya perlu jika akun BELUM terdaftar di MetaApi
# (server akan mendaftarkannya otomatis).
EXNESS_LOGIN=12345678
EXNESS_PASSWORD=password-trading-anda
# Nama server terlihat di aplikasi/email Exness, contoh:
#   Exness-MT5Trial7  (demo)  |  Exness-MT5Real8  (real)
EXNESS_SERVER=Exness-MT5Trial7

# 1 = bot GoldScalper langsung menyala dan trading otomatis begitu tersambung
AUTO_START_BOT=0

# Port web server (opsional)
# PORT=3000
